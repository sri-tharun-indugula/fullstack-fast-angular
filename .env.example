# MCP tokens (set as Windows user env vars, or load via Cursor mcp.json envFile)
GITHUB_PAT=
CONTEXT7_API_KEY=

# Local Postgres from docker-compose.yml (user hrms, database hrms).
DATABASE_URL=postgresql+asyncpg://hrms:hrms@localhost:5432/hrms

# Required. Use a long random value. Never commit a real secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins. Do not use * (cookies require an explicit origin).
CORS_ORIGINS=http://localhost:4200

REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

# Required by `python -m app.seed`. Leave empty in git; set only in local .env.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Admin
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=
SEED_MANAGER_NAME=Team Manager
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_NAME=Alex Employee

# Local document uploads (gitignored). Optional override.
# DOCUMENTS_STORAGE_PATH=data/documents
# DOCUMENT_MAX_BYTES=5242880

# APP_ENV=development
# AUTH_RATE_LIMIT_PER_MINUTE=30
